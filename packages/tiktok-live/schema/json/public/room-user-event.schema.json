{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ttl-live.dev/schema/public/room-user-event.schema.json",
  "title": "ttl-live Room User Event",
  "x-typescript-name": "RoomUserEvent",
  "allOf": [
    { "$ref": "./base-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "roomUser" },
        "viewers": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "popularity": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "totalUser": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "anonymous": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "topViewers": { "type": "array", "items": { "$ref": "./top-viewer.schema.json" } },
        "rankedViewers": { "type": "array", "items": { "$ref": "./top-viewer.schema.json" } }
      },
      "required": [
        "type", "viewers", "popularity", "totalUser", "anonymous", "topViewers", "rankedViewers"
      ],
      "additionalProperties": true,
      "x-typescript-no-index": true
    }
  ]
}
