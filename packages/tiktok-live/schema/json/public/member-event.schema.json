  "$id": "https://ttl-live.dev/schema/public/member-event.schema.json",
  "title": "ttl-live Member Event",
  "x-typescript-name": "MemberEvent",
  "allOf": [
    { "$ref": "./base-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "member" },
        "user": { "$ref": "./event-user.schema.json" },
        "memberCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "action": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      },
      "required": ["type", "user", "memberCount", "action"],
      "additionalProperties": true,
      "x-typescript-no-index": true
    }
  ]
}
