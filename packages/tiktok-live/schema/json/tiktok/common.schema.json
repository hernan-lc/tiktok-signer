{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ttl-live.dev/schema/tiktok/common.schema.json",
  "title": "TikTok JSON common definitions",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "x-expected": "numeric string"
    },
    "idOrSafeNumber": {
      "anyOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      ],
      "x-expected": "numeric string or safe integer"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "x-expected": "safe non-negative integer"
    },
    "image": {
      "type": "object",
      "properties": {
        "url_list": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
